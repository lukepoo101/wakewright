{
  "openapi": "3.1.0",
  "info": {
    "title": "Wakewright worker API",
    "version": "3",
    "description": "How a worker advertises its judge types, claims clips from a Wakewright parent, downloads their audio and returns each judge's result. See docs/workers.md and docs/judges.md.",
    "license": {
      "name": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    }
  },
  "components": {
    "securitySchemes": {
      "workerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "The worker's own token, shown once when the worker is created in the parent's Workers tab, or set in the parent's configuration for a declared worker."
      }
    },
    "schemas": {
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The job id, for posting its results."
          },
          "clipId": {
            "type": "string"
          },
          "wakeWord": {
            "type": "string",
            "example": "alexa"
          },
          "judges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobJudge"
            },
            "description": "The judges to run on this clip, each of a type the worker offered."
          },
          "leaseExpiresAt": {
            "type": "string",
            "description": "Results after this time are refused with 409.",
            "example": "2026-11-18T12:02:00.000Z"
          }
        },
        "required": ["id", "clipId", "wakeWord", "judges", "leaseExpiresAt"]
      },
      "JobJudge": {
        "type": "object",
        "properties": {
          "instance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "A judge (instance) the owner configured on the parent's Judges page.",
            "example": "0198f6a2-7c41-7b8e-9d1a-4f2b3c5d6e7f"
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
            "example": "openai-compatible"
          },
          "settings": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": "Every setting of the judge, secrets included, by key. Never log them or keep them after the job.",
            "example": {
              "base_url": "https://api.example.com/v1",
              "api_key": "sk-example",
              "model": "whisper-1"
            }
          }
        },
        "required": ["instance", "type", "settings"]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "invalid_request"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["error", "message"]
      },
      "UnsupportedProtocol": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": ["unsupported_protocol"]
          },
          "message": {
            "type": "string"
          },
          "supported": {
            "type": "object",
            "properties": {
              "min": {
                "type": "integer"
              },
              "max": {
                "type": "integer"
              }
            },
            "required": ["min", "max"]
          }
        },
        "required": ["error", "message", "supported"]
      },
      "ClaimRequest": {
        "type": "object",
        "properties": {
          "protocol": {
            "type": "integer",
            "description": "The worker protocol version the worker speaks. A parent answers 426 to a version it does not speak; this one speaks 2 to 3.",
            "example": 3
          },
          "worker": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "example": "judge-laptop"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "example": "0.3.0"
              }
            },
            "required": ["name", "version"],
            "description": "What the worker says about itself, shown in the UI beside the worker's own name: usually its host name and its version. The token, not this name, identifies the worker."
          },
          "types": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OfferedType"
            },
            "minItems": 1,
            "maxItems": 20,
            "description": "The judge types this worker can run now."
          },
          "max": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32,
            "default": 8,
            "description": "The most jobs to hand out."
          },
          "waitSeconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 60,
            "default": 25,
            "description": "How long to wait for work when there is none now."
          }
        },
        "required": ["protocol", "worker", "types"]
      },
      "OfferedType": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
            "example": "openai-compatible"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "openai-compatible+1",
            "description": "Changes whenever the type's model or logic changes in a way that can change a verdict; every clip is then judged again."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "OpenAI-compatible transcription"
          },
          "kind": {
            "type": "string",
            "enum": ["wake_word_model", "speech_to_text", "listening"],
            "description": "`wake_word_model`; `speech_to_text`: transcribes, then looks for the wake word in the transcript; `listening` (protocol 3): asks an audio model directly whether someone says the wake word."
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "default": ""
          },
          "external": {
            "type": "boolean",
            "default": false,
            "description": "True when the type sends clips to a service outside the worker; the UI warns before such a judge is turned on."
          },
          "wakeWords": {
            "type": ["array", "null"],
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "maxItems": 200,
            "description": "The wake words this type has a model for, or null for any wake word.",
            "example": null
          },
          "settings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SettingField"
            },
            "maxItems": 30,
            "default": [],
            "description": "The form the Judges page shows for a judge of this type."
          }
        },
        "required": ["id", "version", "name", "kind", "wakeWords"]
      },
      "SettingField": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "example": "model"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Model"
          },
          "type": {
            "type": "string",
            "enum": ["text", "long_text", "secret", "number", "select", "boolean"],
            "description": "How the form shows it. `long_text` is text on several lines (protocol 3). A secret (an API key) is stored encrypted and never shown again."
          },
          "help": {
            "type": "string",
            "maxLength": 1000,
            "default": ""
          },
          "default": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "maxLength": 200
                },
                "label": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": ["value", "label"]
            },
            "maxItems": 100,
            "default": [],
            "description": "The choices of a select."
          },
          "minimum": {
            "type": ["number", "null"],
            "default": null
          },
          "maximum": {
            "type": ["number", "null"],
            "default": null
          },
          "placeholder": {
            "type": "string",
            "maxLength": 8000,
            "default": "",
            "description": "Shown in the empty field, for example the text an empty value stands for."
          },
          "affectsVerdict": {
            "type": "boolean",
            "default": true,
            "description": "Whether changing it can change a verdict. If so, changing it judges every clip again. Ignored for a secret, which never does."
          }
        },
        "required": ["key", "label", "type"]
      },
      "JobResults": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JudgeResult"
            },
            "minItems": 1,
            "maxItems": 20
          }
        },
        "required": ["results"]
      },
      "JudgeResult": {
        "type": "object",
        "properties": {
          "instance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "A judge (instance) the owner configured on the parent's Judges page.",
            "example": "0198f6a2-7c41-7b8e-9d1a-4f2b3c5d6e7f"
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$",
            "example": "openai-compatible"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "openai-compatible+1",
            "description": "The version of the type that ran."
          },
          "verdict": {
            "type": "string",
            "enum": ["yes", "no", "abstain", "failed"],
            "description": "Does the clip contain its wake word? `abstain`, with a detail, when the judge cannot say for this clip (no model for its wake word, unusable audio). `failed`, with a detail and `failure`, when it cannot answer now (rate limited, quota used up, network, a refused key): nothing is recorded, the judge is paused and the clip tried again later."
          },
          "score": {
            "type": ["number", "null"]
          },
          "threshold": {
            "type": ["number", "null"]
          },
          "transcript": {
            "type": ["string", "null"],
            "maxLength": 2000
          },
          "detail": {
            "type": ["string", "null"],
            "maxLength": 2000
          },
          "failure": {
            "type": ["object", "null"],
            "properties": {
              "reason": {
                "type": "string",
                "enum": ["auth", "rate_limit", "quota", "network", "server", "other"]
              },
              "retryAfterSeconds": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 86400,
                "description": "When the service said to try again, if it did."
              }
            },
            "default": null,
            "required": ["reason", "retryAfterSeconds"],
            "description": "For `failed` only."
          },
          "durationMs": {
            "type": "number",
            "minimum": 0,
            "description": "How long the judge took."
          }
        },
        "required": [
          "instance",
          "type",
          "version",
          "verdict",
          "score",
          "threshold",
          "transcript",
          "detail",
          "durationMs"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/worker/v1/jobs/claim": {
      "post": {
        "tags": ["worker"],
        "summary": "Lease clips to judge, waiting for one when there are none (long poll)",
        "description": "Records the judge types the worker offers, then hands out up to `max` clips, newest first, that lack a current result (the offered type version and the judge's settings) from an enabled judge of an offered type the worker may run, and that no other worker holds. A judge paused after a failure or at its daily limit is left out; a paused worker gets no jobs. Each clip is leased to this claim for about two minutes. With nothing to do, the request waits up to `waitSeconds` and answers an empty list. Every claim records the worker as seen.",
        "security": [
          {
            "workerToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Jobs, possibly none",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jobs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Job"
                      }
                    }
                  },
                  "required": ["jobs"]
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No token, or a token that is not a worker's: wrong, replaced, or its worker was deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "426": {
            "description": "The parent does not speak this protocol version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnsupportedProtocol"
                }
              }
            }
          }
        }
      }
    },
    "/api/worker/v1/clips/{clipId}/audio": {
      "get": {
        "tags": ["worker"],
        "summary": "A clip's audio: 16 kHz mono 16-bit PCM WAV",
        "security": [
          {
            "workerToken": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "clipId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The WAV file",
            "content": {
              "audio/wav": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "No token, or a token that is not a worker's: wrong, replaced, or its worker was deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such clip",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/worker/v1/jobs/{id}/results": {
      "post": {
        "tags": ["worker"],
        "summary": "Send a job's results; ends its lease",
        "description": "At most one result per judge the job named. A judge left out is offered again on a later claim. A judge that cannot answer this clip reports `abstain` with a `detail`, so the clip is not retried forever; one that cannot answer now reports `failed`, which pauses the judge.",
        "security": [
          {
            "workerToken": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobResults"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Stored"
          },
          "400": {
            "description": "The request is not valid, or names a judge or version the job did not ask for",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No token, or a token that is not a worker's: wrong, replaced, or its worker was deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The lease has expired, was released (the worker was paused or changed) or belongs to another worker: claim again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
